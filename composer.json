{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "stanislas-poisson/php-dev-tools",
    "description": "The quality settings of the zairakai PHP projects, without Laravel: Pint, PHPStan, Rector, PHP Insights and markdownlint configurations, with the thin files for the editor, as a base that a project extends.",
    "type": "library",
    "keywords": [
        "dev-tools",
        "phpstan",
        "rector",
        "pint",
        "phpinsights",
        "markdownlint",
        "code-quality",
        "configuration"
    ],
    "license": "MIT",
    "homepage": "https://github.com/Stanislas-Poisson/php-dev-tools",
    "authors": [
        {
            "name": "Stanislas Poisson",
            "email": "stanislas.p@the-white-rabbits.fr",
            "homepage": "https://github.com/Stanislas-Poisson",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/Stanislas-Poisson/php-dev-tools/issues",
        "source": "https://github.com/Stanislas-Poisson/php-dev-tools",
        "docs": "https://github.com/Stanislas-Poisson/php-dev-tools#readme",
        "security": "https://github.com/Stanislas-Poisson/php-dev-tools/security/policy"
    },
    "funding": [
        {
            "type": "patreon",
            "url": "https://www.patreon.com/c/zairakai"
        },
        {
            "type": "other",
            "url": "https://www.twitch.tv/zairakai"
        }
    ],
    "require": {
        "php": ">=8.4",
        "laravel/pint": "^1.32.3",
        "nunomaduro/phpinsights": "^2.12",
        "phpstan/phpstan": "^2.3.5",
        "phpstan/phpstan-phpunit": "^2.1.2",
        "phpstan/phpstan-strict-rules": "^2.1.1",
        "rector/rector": "^2.8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.44"
    },
    "autoload": {
        "psr-4": {
            "StanislasPoisson\\DevTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StanislasPoisson\\DevTools\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "audit": {
            "ignore-severity": [
                "low",
                "medium"
            ]
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.0"
        },
        "preferred-install": "dist",
        "process-timeout": 0,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "authors": [
            {
                "email": [
                    "stanislas.p@the-white-rabbits.fr"
                ],
                "name": "Stanislas Poisson",
                "notes": "Primary maintainer",
                "social": {
                    "github": "https://github.com/Stanislas-Poisson",
                    "gitlab": "https://gitlab.com/zairakai",
                    "linkedin": "https://www.linkedin.com/in/stanislasp/",
                    "stanislas-poisson": "https://stanislas-poisson.fr",
                    "the-white-rabbits": "https://the-white-rabbits.fr",
                    "twitch": "https://twitch.tv/zairakai"
                }
            }
        ]
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "cs": "pint --test --config config/pint.json",
        "cs:fix": "pint --config config/pint.json",
        "cs-fix": "@cs:fix",
        "insights": "phpinsights analyse --no-interaction --config-path=phpinsights.php",
        "markdown": "npx --yes markdownlint-cli2 '**/*.md' '#vendor' '#build' '#docs' '#**/node_modules'",
        "quality": [
            "@cs",
            "@analyse",
            "@rector",
            "@insights",
            "@test"
        ],
        "quality:fix": [
            "@rector:fix",
            "@cs:fix"
        ],
        "quality-fix": "@quality:fix",
        "rector": "rector process --dry-run --no-progress-bar",
        "rector:fix": "rector process --no-progress-bar",
        "rector-fix": "@rector:fix",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    }
}
