{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "stanislas-poisson/php-dev-tools",
    "description": "The quality tools of the zairakai PHP projects, without Laravel: Pint, PHPStan, Rector, PHP Insights, markdownlint and the Git hooks, as a base that a project extends.",
    "type": "library",
    "keywords": [
        "dev-tools",
        "phpstan",
        "rector",
        "pint",
        "phpinsights",
        "markdownlint",
        "git-hooks",
        "code-quality"
    ],
    "license": "MIT",
    "homepage": "https://github.com/Stanislas-Poisson/php-dev-tools",
    "authors": [
        {
            "name": "Stanislas Poisson",
            "email": "stanislas.p@the-white-rabbits.fr",
            "homepage": "https://github.com/Stanislas-Poisson",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/Stanislas-Poisson/php-dev-tools/issues",
        "source": "https://github.com/Stanislas-Poisson/php-dev-tools",
        "docs": "https://github.com/Stanislas-Poisson/php-dev-tools#readme",
        "security": "https://github.com/Stanislas-Poisson/php-dev-tools/security/policy"
    },
    "funding": [
        {
            "type": "patreon",
            "url": "https://www.patreon.com/c/zairakai"
        },
        {
            "type": "other",
            "url": "https://www.twitch.tv/zairakai"
        }
    ],
    "require": {
        "php": ">=8.2",
        "laravel/pint": "^1.13",
        "nunomaduro/phpinsights": "^2.12",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "StanislasPoisson\\DevTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StanislasPoisson\\DevTools\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/php-dev-tools"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        },
        "preferred-install": "dist",
        "process-timeout": 0,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "authors": [
            {
                "email": [
                    "stanislas.p@the-white-rabbits.fr"
                ],
                "name": "Stanislas Poisson",
                "notes": "Primary maintainer",
                "social": {
                    "github": "https://github.com/Stanislas-Poisson",
                    "gitlab": "https://gitlab.com/zairakai",
                    "linkedin": "https://www.linkedin.com/in/stanislasp/",
                    "stanislas-poisson": "https://stanislas-poisson.fr",
                    "the-white-rabbits": "https://the-white-rabbits.fr",
                    "twitch": "https://twitch.tv/zairakai"
                }
            }
        ]
    },
    "scripts": {
        "analyse": "php bin/php-dev-tools analyse",
        "cs": "php bin/php-dev-tools cs",
        "cs:fix": "php bin/php-dev-tools cs:fix",
        "insights": "php bin/php-dev-tools insights",
        "markdown": "php bin/php-dev-tools markdown",
        "quality": [
            "php bin/php-dev-tools quality",
            "@test"
        ],
        "quality:fast": "php bin/php-dev-tools quality:fast",
        "quality:fix": "php bin/php-dev-tools quality:fix",
        "rector": "php bin/php-dev-tools rector",
        "rector:fix": "php bin/php-dev-tools rector:fix",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    }
}
