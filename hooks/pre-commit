#!/usr/bin/env bash
#
# Pre-commit hook: runs the quick quality checks (code style and static analysis).
# Copied from zairakai/laravel-dev-tools and adapted: it runs the Composer script of the project.
#
# To bypass (emergency only):
#   git commit --no-verify

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

cd "$(git rev-parse --show-toplevel)"

if ! command -v composer &>/dev/null; then
    echo -e "${YELLOW}composer not found - skipping the quality checks${NC}"
    exit 0
fi

echo -e "${CYAN}Pre-commit: composer quality:fast${NC}"

if composer quality:fast; then
    echo -e "${GREEN}Quality checks passed - commit allowed${NC}"
    exit 0
fi

echo -e "${RED}Quality checks failed!${NC}"
echo -e "Fix what can be fixed with ${CYAN}composer quality:fix${NC}, or bypass with ${CYAN}git commit --no-verify${NC} (not recommended)."
exit 1
