#!/usr/bin/env bash
#
# Pre-push hook: runs the whole quality gate (style, analysis, Rector, PHP Insights and the tests).
# Copied from zairakai/laravel-dev-tools and adapted: it runs the Composer script of the project.
#
# To bypass (emergency only):
#   git push --no-verify

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

cd "$(git rev-parse --show-toplevel)"

if ! command -v composer &>/dev/null; then
    echo -e "${YELLOW}composer not found - skipping the quality gate${NC}"
    exit 0
fi

echo -e "${CYAN}Pre-push: composer quality${NC}"

if composer quality; then
    echo -e "${GREEN}Quality gate passed - push allowed${NC}"
    exit 0
fi

echo -e "${RED}Quality gate failed!${NC}"
echo -e "Fix what can be fixed with ${CYAN}composer quality:fix${NC}, or bypass with ${CYAN}git push --no-verify${NC} (not recommended)."
exit 1
