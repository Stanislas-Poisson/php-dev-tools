# Default: treat everything as text and normalize the line endings to LF
* text=auto eol=lf

# Markdown files: readable diffs
*.md diff=markdown

# Binary files (SVG is text: it keeps its diffs)
*.png binary

# Left out of the archive of the package (git archive)

# Folders
/.github export-ignore
/assets export-ignore
/docs export-ignore
/tests export-ignore

# Files
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.markdownlint.json export-ignore
/.markdownlintignore export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md export-ignore
/SECURITY.md export-ignore
/phpinsights.php export-ignore
/phpstan.neon export-ignore
/phpunit.xml export-ignore
/pint.json export-ignore
/rector.php export-ignore
